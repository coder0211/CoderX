# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=your_telegram_user_id_here  # comma-separated

# OpenAI (ChatGPT)
OPENAI_API_KEY=your_openai_api_key_here
SMART_MODEL=gpt-5-mini      # Reasoning nặng: TaskPlanner, AgentBrain (ReAct loop)
FAST_MODEL=gpt-5-nano       # Tác vụ đơn giản: Summarize, Final Report, Telegram Chat

# Antigravity
ANTIGRAVITY_CLI=/Applications/Antigravity.app/Contents/Resources/app/bin/antigravity

# Workspace
DEFAULT_WORKSPACE=/Users/your_username/Documents/your_project

# Timeouts (seconds)
STEP_TIMEOUT=600       # Max wait per step (10 mins)
STEP_IDLE_TIMEOUT=300  # Consider done after 5 mins of no file changes
MAX_ITERATIONS=15      # Max autonomous ReAct loop cycles

# ─────────────────────────────────────────────────────────────────────────────
# MCP Client — Gọi tools từ external MCP servers
# Cấu hình servers trong file mcp.json (xem mcp_client/README.md)
# ─────────────────────────────────────────────────────────────────────────────
MCP_ENABLED=true        # Bật/tắt MCP client (default: true)
MCP_TOOL_TIMEOUT=30     # Timeout gọi từng tool, tính bằng giây

# Tuỳ chọn: override đường dẫn file config (mặc định: ./mcp.json)
# MCP_CONFIG_FILE=/path/to/custom/mcp.json
