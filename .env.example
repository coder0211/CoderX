# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=your_telegram_user_id_here  # comma-separated

# OpenAI (ChatGPT)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-nano

# Antigravity
ANTIGRAVITY_CLI=/Applications/Antigravity.app/Contents/Resources/app/bin/antigravity

# Workspace
DEFAULT_WORKSPACE=/Users/your_username/Documents/your_project

# Timeouts (seconds)
STEP_TIMEOUT=600       # Max wait per step (10 mins)
STEP_IDLE_TIMEOUT=300   # Consider done after 5 mins of no file changes
MAX_ITERATIONS=15      # Max autonomous ReAct loop cycles
